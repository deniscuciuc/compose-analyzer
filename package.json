{
  "name": "@deniscuciuc/compose-analyzer",
  "version": "1.1.0",
  "description": "CLI tool that analyzes Docker Compose files for image hygiene, security, reliability, resource limits, and network exposure.",
  "keywords": [
    "docker",
    "docker-compose",
    "compose",
    "analyzer",
    "security",
    "devops",
    "cli",
    "containers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deniscuciuc/compose-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/deniscuciuc/compose-analyzer/issues"
  },
  "license": "MIT",
  "author": "Denis Cuciuc <denis@deniscuciuc.dev>",
  "homepage": "https://github.com/deniscuciuc/compose-analyzer#readme",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "compose-analyzer": "./dist/src/cli/main.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "analyzerrc.example.json"
  ],
  "scripts": {
    "start": "node dist/src/cli/main.js start",
    "analyze": "node dist/src/cli/main.js",
    "analyze:help": "node dist/src/cli/main.js --help",
    "analyze:health": "node dist/src/cli/main.js -j -c health",
    "analyze:images": "node dist/src/cli/main.js -j -c images",
    "analyze:security": "node dist/src/cli/main.js -j -c security",
    "analyze:reliability": "node dist/src/cli/main.js -j -c reliability",
    "analyze:resources": "node dist/src/cli/main.js -j -c resources",
    "analyze:networks": "node dist/src/cli/main.js -j -c networks",
    "analyze:html": "node dist/src/cli/main.js --html -c full",
    "build": "rm -rf dist && tsc && node scripts/add-shebang.js",
    "postbuild": "node scripts/add-shebang.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test dist/test/*.test.js",
    "prepublishOnly": "pnpm lint && pnpm build && pnpm test",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "js-yaml": "^5.4.1"
  },
  "optionalDependencies": {
    "dockerode": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.19.21",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
